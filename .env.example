# Optional NCBI credentials and contact metadata. NCBI Datasets CLI reads
# NCBI_API_KEY directly and grants its enhanced request-rate limit.
NCBI_API_KEY=
# Legacy fallback retained for old local wrappers; new commands use NCBI_API_KEY.
NCBI_DATASETS_API_KEY=
NCBI_TAXONOMY_EMAIL=

# Optional Weights & Biases authentication
WANDB_API_KEY=

# Optional runtime controls
BPE_SAMPLE_BYTES=100000000
DNA_STRICT_CHECKPOINT_LOAD=0
